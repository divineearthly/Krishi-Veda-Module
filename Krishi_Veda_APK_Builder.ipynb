   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🕉️ Krishi-Veda APK Builder\n",
    "### Builds the APK and auto-uploads to GitHub Releases\n",
    "\n",
    "1. Run each cell in order\n",
    "2. When prompted, enter your GitHub token\n",
    "3. APK will be built and uploaded automatically"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Install dependencies\n",
    "!pip install -q buildozer cython\n",
    "!sudo apt-get update -qq && sudo apt-get install -y -qq python3-pip python3-dev build-essential git autoconf automake libtool pkg-config zlib1g zlib1g-dev libncurses-dev cmake libffi-dev libssl-dev zip unzip openjdk-17-jdk"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Clone the repository\n",
    "import os\n",
    "os.chdir('/content')\n",
    "!git clone https://github.com/divineearthly/Krishi-Veda-Module.git\n",
    "os.chdir('/content/Krishi-Veda-Module')\n",
    "print('Repository cloned')\n",
    "!ls -la"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Set your GitHub token (create at https://github.com/settings/tokens)\n",
    "# Required scopes: repo\n",
    "from getpass import getpass\n",
    "GITHUB_TOKEN = getpass('Enter your GitHub Personal Access Token: ')\n",
    "os.environ["GITHUB_TOKEN"] = GITHUB_TOKEN\n",
    "print('Token set')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Build the APK\n",
    "!export CFLAGS=\"-I/usr/include\" && export LDFLAGS=\"-L/usr/lib/x86_64-linux-gnu\" && yes | buildozer android release"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Find and rename the APK\n",
    "import glob\n",
    "apk_files = glob.glob('**/*.apk', recursive=True)\n",
    "if apk_files:\n",
    "    apk_path = apk_files[0]\n",
    "    print(f'APK found: {apk_path}')\n",
    "    !cp \"$apk_path\" /content/krishi-veda.apk\n",
    "    print('APK copied to /content/krishi-veda.apk')\n",
    "else:\n",
    "    print('No APK found! Check build logs above.')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Upload to GitHub Releases\n",
    "import requests\n",
    "import os\n",
    "import json\n",
    "from datetime import datetime\n",
    "\n",
    "token = os.environ.get('GITHUB_TOKEN')\n",
    "if not token:\n",
    "    print('No GitHub token found. Run the token cell first.')\n",
    "else:\n",
    "    repo = 'divineearthly/Krishi-Veda-Module'\n",
    "    tag = f'v{datetime.now().strftime(\"%Y%m%d%H%M%S\")}'\n",
    "    \n",
    "    # Create release\n",
    "    release_data = {\n",
    "        'tag_name': tag,\n",
    "        'name': f'Krishi-Veda APK - {datetime.now().strftime(\"%d %b %Y\")}',\n",
    "        'body': '🕉️ Krishi-Veda Android App\\n\\nBuilt via Google Colab\\nAuto-update enabled',\n",
    "        'prerelease': False\n",
    "    }\n",
    "    \n",
    "    headers = {\n",
    "        'Authorization': f'token {token}',\n",
    "        'Accept': 'application/vnd.github.v3+json'\n",
    "    }\n",
    "    \n",
    "    # Create the release\n",
    "    r = requests.post(\n",
    "        f'https://api.github.com/repos/{repo}/releases',\n",
    "        headers=headers,\n",
    "        json=release_data\n",
    "    )\n",
    "    \n",
    "    if r.status_code == 201:\n",
    "        release = r.json()\n",
    "        upload_url = release['upload_url'].split('{')[0]\n",
    "        print(f'Release created: {release[\"html_url\"]}')\n",
    "        \n",
    "        # Upload APK\n",
    "        apk_path = '/content/krishi-veda.apk'\n",
    "        if os.path.exists(apk_path):\n",
    "            with open(apk_path, 'rb') as f:\n",
    "                upload_headers = {\n",
    "                    'Authorization': f'token {token}',\n",
    "                    'Content-Type': 'application/vnd.android.package-archive'\n",
    "                }\n",
    "                upload = requests.post(\n",
    "                    f'{upload_url}?name=krishi-veda.apk',\n",
    "                    headers=upload_headers,\n",
    "                    data=f\n",
    "                )\n",
    "                if upload.status_code == 201:\n",
    "                    print('✅ APK uploaded successfully!')\n",
    "                    print(f'Download: {release[\"html_url\"]}')\n",
    "                else:\n",
    "                    print(f'Upload failed: {upload.status_code}')\n",
    "                    print(upload.text[:200])\n",
    "        else:\n",
    "            print('APK file not found at /content/krishi-veda.apk')\n",
    "    else:\n",
    "        print(f'Release creation failed: {r.status_code}')\n",
    "        print(r.text[:200])"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Download APK to your computer\n",
    "from google.colab import files\n",
    "import os\n",
    "if os.path.exists('/content/krishi-veda.apk'):\n",
    "    files.download('/content/krishi-veda.apk')\n",
    "else:\n",
    "    print('No APK to download. Build may have failed.')"
   ],
   "execution_count": null,
   "outputs": []
  }
